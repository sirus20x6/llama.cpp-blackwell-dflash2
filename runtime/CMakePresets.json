{
  "version": 4,
  "configurePresets": [
    {
      "name": "cuda-release",
      "displayName": "CUDA release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GGML_CUDA": "ON",
        "ADVANCED_GGUF_QUANTIZER_STANDALONE": "ON"
      }
    },
    {
      "name": "cuda-debug",
      "displayName": "CUDA debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GGML_CUDA": "ON",
        "ADVANCED_GGUF_QUANTIZER_STANDALONE": "ON"
      }
    },
    {
      "name": "cuda-release-with-helpers",
      "displayName": "CUDA release with optional evidence helpers",
      "inherits": "cuda-release",
      "binaryDir": "${sourceDir}/build-helpers",
      "cacheVariables": {
        "ADVANCED_GGUF_QUANTIZER_BUILD_BENCH": "ON",
        "ADVANCED_GGUF_QUANTIZER_BUILD_FIT_PARAMS": "ON"
      }
    },
    {
      "name": "cuda-blackwell-performance",
      "displayName": "CUDA Blackwell performance runtime",
      "inherits": "cuda-release",
      "binaryDir": "${sourceDir}/build-blackwell-performance",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "120a-real",
        "GGML_CUDA_FA": "ON",
        "GGML_CUDA_FA_ALL_QUANTS": "ON",
        "GGML_CUDA_GRAPHS": "ON",
        "GGML_CUDA_COMPRESSION_MODE": "speed",
        "GGML_CUDA_FORCE_CUBLAS": "OFF",
        "GGML_CUDA_FORCE_MMQ": "OFF",
        "GGML_CUDA_NCCL": "OFF",
        "GGML_CUDA_NO_VMM": "OFF",
        "GGML_LTO": "ON",
        "GGML_NATIVE": "ON",
        "ADVANCED_GGUF_QUANTIZER_BUILD_BENCH": "ON",
        "ADVANCED_GGUF_QUANTIZER_BUILD_FIT_PARAMS": "OFF",
        "LLAMA_BUILD_TESTS": "OFF"
      }
    }
  ]
}
